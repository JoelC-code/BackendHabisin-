# ─────────────────────────────────────────────────────────────
# Habisin Backend — contoh konfigurasi environment.
# Copy file ini jadi ".env" lalu isi nilainya:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Database (Postgres) ──────────────────────────────────────
# Pilih salah satu:
# 1) Supabase (disarankan untuk demo bareng — tinggal share string ini):
#    Ambil dari Supabase > Project Settings > Database > Connection string >
#    pilih "Connection pooling" (port 6543), mode "Transaction".
#    Wajib tambahkan ?pgbouncer=true di akhir.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-xxx.pooler.supabase.com:6543/postgres?pgbouncer=true"
# 2) Postgres lokal (kalau jalan sendiri di laptop):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/habisin"

# ── Server ───────────────────────────────────────────────────
PORT=3000
# Ganti dengan string acak panjang & rahasia.
JWT_SECRET_KEY="ganti-dengan-secret-acak-yang-panjang"

# ── AI (Gemini) ──────────────────────────────────────────────
# API key gratis dari https://aistudio.google.com/app/apikey
GEMINI_API_KEY="isi-gemini-api-key-mu"
GEMINI_MODEL="gemini-2.5-flash-lite"

# ── Monetisasi / pembayaran ──────────────────────────────────
# false (default) = mode demo: fitur premium kebuka untuk semua, TANPA perlu
# Midtrans/ngrok. Set true hanya kalau mau menjalankan flow bayar sungguhan.
PAYMENTS_ENABLED=false

# Batas generate resep AI per user per hari (cost-control Gemini, untuk semua user).
DAILY_GENERATE_LIMIT=15

# Default H-berapa hari makanan dianggap "akan expired" (bisa di-override ?days=N).
EXPIRY_THRESHOLD_DAYS=3

# ── Midtrans (HANYA dibutuhkan kalau PAYMENTS_ENABLED=true) ───
# Untuk demo lokal biasa, biarkan kosong / abaikan.
MIDTRANS_MERCHANT_ID=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_SERVER_KEY=""
MIDTRANS_IS_PRODUCTION=false
# Plan bulanan
SUBSCRIPTION_PRICE_IDR=15000
SUBSCRIPTION_DURATION_DAYS=30
# Plan tahunan
YEARLY_PRICE_IDR=180000
YEARLY_DURATION_DAYS=365
