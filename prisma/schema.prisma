// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql" // WAJIB postgresql
  url      = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement()) @map("user_id")
  email String @unique @db.VarChar(255)
  password String @db.VarChar(255)
  username String @db.VarChar(255)

  subscription Subscription[]

  food Food[]

  resep Resep[]

  generationLog GenerationLog[]
}

model Subscription {
  id          Int       @id @default(autoincrement())
  userId      Int                                  
  orderId     String    @unique                    
  amount      Int                                  
  status      String                              
  paymentType String?                             
  startDate   DateTime?                            
  endDate     DateTime?                         
  createdAt   DateTime  @default(now())        
  updatedAt   DateTime  @updatedAt                 
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([status])
}

model Food {
  id Int @id @default(autoincrement()) @map("card_id")
  foodName String @db.VarChar(100)
  descriptionFood String @db.VarChar(255)
  user_id Int
  bestBefore DateTime
  quantity Int
  category FoodCategory
  imageUrl String?
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Resep {
  id Int @id @default(autoincrement()) @map("card_id")
  resepName String @db.VarChar(100)
  resepDescription String @db.VarChar(255)
  resepCategory    String   @db.VarChar(50)
  resepIngredients String[]
  resepDirections String[]

  user_id Int 
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// Katalog resep kurasi (resep Indonesia siap-jelajah, bukan AI per-user).
// isPremium=true → cuma bisa dibuka subscriber (PRO). Free bisa lihat di list
// tapi detailnya terkunci.
model CatalogRecipe {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  description String   @db.VarChar(500)
  category    String   @db.VarChar(50)
  ingredients String[]
  directions  String[]
  imageUrl    String?
  isPremium   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([category])
}

// Mencatat tiap kali user generate resep via AI — dipakai untuk
// menghitung kuota harian (cost-control Gemini).
model GenerationLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum FoodCategory {
  PRODUCE
  DAIRY
  MEAT
  OTHER
}

